def get_predictions(real_age=25):
    """Generate AI predictions"""
    wrinkle = round(random.uniform(0.5, 4.8), 1)
    dark_spot = round(random.uniform(3, 40), 1)
    puffy_eye = round(random.uniform(2, 35), 1)
    acne = round(random.uniform(0, 20), 1)
    blackheads = round(random.uniform(0, 25), 1)
    
    skin_age = real_age + random.randint(-5, 10) if real_age else random.randint(20, 50)
    
    health_score = round(100 - (0.25*(wrinkle/5*100) + 0.2*dark_spot + 0.15*puffy_eye + 0.2*acne + 0.2*blackheads), 1)
    health_score = max(0, min(100, health_score))
    
    if health_score >= 80:
        category, score_class = "Excellent", "score-excellent"
    elif health_score >= 60:
        category, score_class = "Good", "score-good"
    else:
        category, score_class = "Needs Care", "score-care"
    
    return {
        "wrinkle_score": wrinkle, "dark_spot_score": dark_spot,
        "puffy_eye_score": puffy_eye, "acne_score": acne,
        "blackheads_score": blackheads, "predicted_skin_age": skin_age,
        "health_score": health_score, "health_category": category,
        "score_class": score_class
    }

